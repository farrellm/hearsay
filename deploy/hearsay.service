[Unit]
Description=Hearsay podcast app (served on the tailnet)
Documentation=file://%h/workspace/hearsay/docs/design.md
# No After=network-online.target / tailscaled.service: a *user* manager cannot
# order against system units. If tailscaled is not up yet, ExecStartPost fails
# and the unit retries forever instead.
StartLimitIntervalSec=0

[Service]
Type=simple
# hearsay.toml is read from here; relative paths in it resolve against the repo.
WorkingDirectory=%h/workspace/hearsay
# The colab CLI is a `uv tool` install in ~/.local/bin; ffmpeg lives in /usr/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
# Binds to host:port from hearsay.toml (default 127.0.0.1:8452). Loopback only:
# the sole way in is the `tailscale serve` proxy below.
ExecStart=%h/workspace/hearsay/.venv/bin/hearsay serve
# HTTPS port 8452 is Hearsay's (~/workspace/TAILSCALE_PORTS.md). A port is an
# origin: the home-screen install is tied to it, so never move it. Idempotent;
# keeps this unit the single source of truth for how Hearsay is exposed.
ExecStartPost=/usr/bin/timeout 15 /usr/bin/tailscale serve --bg --https=8452 http://127.0.0.1:8452
ExecStopPost=-/usr/bin/timeout 15 /usr/bin/tailscale serve --https=8452 off
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
